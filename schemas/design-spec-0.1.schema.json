{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajans-os.local/schemas/design-spec-0.1.schema.json",
  "title": "Design spec v0.1",
  "description": "Agents write this document; renderers consume it. See docs/PROJE_BRIEF.md section 5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "intent", "canvas", "brand_ref", "grid", "layers", "provenance"],
  "properties": {
    "spec_version": { "const": "0.1" },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "audience", "platform"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 280 },
        "audience": { "type": "string", "minLength": 1 },
        "cta": { "type": "string" },
        "platform": {
          "enum": [
            "instagram_post_1x1",
            "instagram_post_4x5",
            "instagram_story_9x16",
            "instagram_carousel_4x5",
            "facebook_post",
            "linkedin_post"
          ]
        },
        "label": {
          "description": "Usage label. Pilot brands must use 'concept_study' (CLAUDE.md).",
          "enum": ["client_work", "concept_study", "internal"]
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h", "unit"],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "h": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "unit": { "const": "px" },
        "background": { "$ref": "#/$defs/color" },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "bottom", "side"],
          "properties": {
            "top": { "$ref": "#/$defs/nonNegInt" },
            "bottom": { "$ref": "#/$defs/nonNegInt" },
            "side": { "$ref": "#/$defs/nonNegInt" }
          }
        }
      }
    },
    "brand_ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "margin", "gutter", "baseline"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1, "maximum": 24 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 48 },
        "margin": { "$ref": "#/$defs/nonNegInt" },
        "gutter": { "$ref": "#/$defs/nonNegInt" },
        "baseline": { "type": "integer", "minimum": 1 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": { "type": { "enum": ["image", "text", "shape"] } },
        "allOf": [
          { "if": { "properties": { "type": { "const": "image" } } }, "then": { "$ref": "#/$defs/imageLayer" } },
          { "if": { "properties": { "type": { "const": "text" } } }, "then": { "$ref": "#/$defs/textLayer" } },
          { "if": { "properties": { "type": { "const": "shape" } } }, "then": { "$ref": "#/$defs/shapeLayer" } }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets"],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "license"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scores": {
          "type": "object",
          "propertyNames": {
            "enum": ["message", "hierarchy", "typography", "layout", "color", "brand", "quality", "platform"]
          },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity"],
            "properties": {
              "code": { "type": "string" },
              "severity": { "enum": ["critical", "major", "minor"] },
              "layer": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonNegInt": { "type": "integer", "minimum": 0 },
    "layerId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "color": {
      "description": "Hex color or brand token (e.g. brand.ink).",
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|brand\\.[a-z][a-z0-9_]*)$"
    },
    "gridPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["col", "span", "row"],
      "properties": {
        "col": { "type": "integer", "minimum": 1 },
        "span": { "type": "integer", "minimum": 1 },
        "row": { "type": "integer", "minimum": 1 },
        "row_span": { "type": "integer", "minimum": 1 }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "placement": {
      "description": "A layer is placed by grid or by box, never both. Neither means full canvas.",
      "not": { "type": "object", "required": ["grid", "box"] }
    },
    "imageLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "src", "fit"],
      "properties": {
        "id": { "$ref": "#/$defs/layerId" },
        "type": { "const": "image" },
        "src": { "type": "string", "pattern": "^asset://[A-Za-z0-9._/-]+$" },
        "fit": { "enum": ["cover", "contain", "fill"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "grid": { "$ref": "#/$defs/gridPlacement" },
        "box": { "$ref": "#/$defs/box" }
      },
      "$ref": "#/$defs/placement"
    },
    "textLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "font", "size", "color", "lang"],
      "properties": {
        "id": { "$ref": "#/$defs/layerId" },
        "type": { "const": "text" },
        "role": { "enum": ["headline", "subhead", "body", "cta", "caption", "label"] },
        "text": { "type": "string", "minLength": 1 },
        "font": { "type": "string", "pattern": "^brand\\.[a-z][a-z0-9_]*$" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 },
        "size": { "type": "number", "minimum": 8, "maximum": 1000 },
        "line_height": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "tracking": { "type": "number", "minimum": -0.2, "maximum": 1 },
        "align": { "enum": ["left", "center", "right"] },
        "color": { "$ref": "#/$defs/color" },
        "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "grid": { "$ref": "#/$defs/gridPlacement" },
        "box": { "$ref": "#/$defs/box" }
      },
      "$ref": "#/$defs/placement"
    },
    "shapeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "shape", "fill"],
      "properties": {
        "id": { "$ref": "#/$defs/layerId" },
        "type": { "const": "shape" },
        "shape": { "enum": ["rect", "ellipse", "line"] },
        "fill": { "$ref": "#/$defs/color" },
        "radius": { "$ref": "#/$defs/nonNegInt" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "grid": { "$ref": "#/$defs/gridPlacement" },
        "box": { "$ref": "#/$defs/box" }
      },
      "$ref": "#/$defs/placement"
    }
  }
}
